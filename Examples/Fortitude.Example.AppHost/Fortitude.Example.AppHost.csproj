<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>2585e503-0ea4-400c-9f91-a34e118f8f23</UserSecretsId>
        <!--
          This AppHost only wires up the example projects for the integration tests; it does
          not use any feature that needs the Aspire CLI bundle.
        -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Fortitude.Server\Fortitude.Server.csproj" />
      <ProjectReference Include="..\Fortitude.Example.Api\Fortitude.Example.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    </ItemGroup>

</Project>
