<Project>
  <!--
      Central package management: every PackageReference in the solution takes its version
      from here, so the five projects cannot drift apart again. Projects reference packages
      by name only.
    -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Jint" Version="4.18.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Routing" Version="2.3.14" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <!--
         Pinned explicitly: Microsoft.AspNetCore.Http pulls 2.3.12 transitively, which carries
         GHSA-6527-9fp8-r4x6. The client calls QueryHelpers directly, so this is a real
         dependency rather than only a pin.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.abstractions" Version="2.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup Label="Examples">
    <PackageVersion Include="Aspire.Hosting" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.Xunit" Version="4.17.0" />
  </ItemGroup>
</Project>