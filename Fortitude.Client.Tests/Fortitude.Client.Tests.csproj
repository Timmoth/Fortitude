<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          The package multi-targets, so the tests that guard it must too. Everything else in
          the solution is net10.0 only because it references Fortitude.Server; this project
          deliberately references nothing but the client, which is what consumers install.
        -->
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Tests.Client</RootNamespace>

        <!--
          Lets the net8.0 and net9.0 builds run on a machine that only has a newer runtime
          installed, so the suite works on any contributor's laptop. CI installs the real
          8.0 and 9.0 runtimes, which is where the exact-runtime result comes from.
        -->
        <RollForward>LatestMajor</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Fortitude.Client\Fortitude.Client.csproj" />
    </ItemGroup>

</Project>
