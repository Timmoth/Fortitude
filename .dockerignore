# Keep the build context to sources. Without this, COPY . . ships every local build
# artifact into the image layer — slow to send, and stale bin/obj from the host can
# shadow what the container build produces.
**/bin/
**/obj/
**/TestResults/
**/.vs/
**/.idea/
.git/
.github/
temp/

# docs/ is NOT excluded: Fortitude.Client packs docs/icon.png, and the client is
# built as part of publishing the server, so dropping it fails the image build.
**/*.user
**/.DS_Store
Dockerfile
.dockerignore
